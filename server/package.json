{
  "name": "online-computers-server",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "prestart": "npm run db:setup",
    "start": "node server.js",
    "predev": "npm run db:setup",
    "dev": "nodemon server.js",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:init": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:validate": "prisma validate",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mysql.ps1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "online-computers": "file:.."
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.0"
  }
}
